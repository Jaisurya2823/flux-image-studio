# ── Nexflow FLUX Image Studio — Environment Variables ─────────────
# Copy this file to .env and fill in your values
# On HuggingFace Spaces: add under Space Settings → Variables and Secrets
# On GitHub: add under Settings → Secrets and variables → Actions

# Your HuggingFace access token (free)
# Get it at: https://huggingface.co/settings/tokens
# Permission needed: Read
HF_TOKEN=hf_your_token_here
